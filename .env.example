# Copy to .env and fill in for production deploys
JWT_SECRET=change-me-to-a-long-random-string

# Optional: AI assistant (task generation + board summaries).
# Without OPENAI_API_KEY the AI button shows a clear "not configured" message.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: shared cloud database (Turso) so data survives redeploys.
# Without these, FlowBoard uses the local SQLite file (data/flowboard.db).
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token
